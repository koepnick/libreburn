# JCZ EZCAD2 LMC galvo board
SUBSYSTEM=="usb", ATTR{idVendor}=="9588", ATTR{idProduct}=="9899", MODE="0660", TAG+="uaccess", GROUP="plugdev"
# Ruida over USB serial: RDC644x boards use an FTDI FT232 (0403:6001), per MeerK40t.
# Other adapters: add their IDs after checking `lsusb`.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0660", TAG+="uaccess", GROUP="dialout"
