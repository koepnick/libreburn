# SPDX-License-Identifier: AGPL-3.0-or-later
# Host firewall for libreburn lab machines, loaded by libreburn-firewall.service.
# Uses its own table so it never flushes rules that Docker or others manage.
table inet libreburn
delete table inet libreburn
table inet libreburn {
  set ssh_allow { type ipv4_addr; flags interval; elements = { @SSH_ALLOW@ } }

  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    meta l4proto { icmp, ipv6-icmp } accept
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
    tcp dport 22 ip saddr @ssh_allow accept
  }

  chain forward {
    type filter hook forward priority 0; policy accept;
@RUIDA_FWD@
  }

  chain output {
    type filter hook output priority 0; policy accept;
@RUIDA_OUT@
  }
}
