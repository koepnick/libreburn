# GPIO interlock / laser-activity guard for the HIL runner (docs/lab-setup.md).
# Runs as root with no capabilities, no network and a read-only filesystem;
# root is only needed so it can stop the runner unit over systemd's socket.
[Unit]
Description=libreburn HIL interlock and laser-activity guard
After=local-fs.target

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/libreburn/libreburn_hil_guard.py daemon
Restart=always
RestartSec=2
RuntimeDirectory=libreburn-hil
RuntimeDirectoryMode=0755
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
